<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="P_335_ReadMe.LoginPage"
             Title="Connexion"
             BackgroundColor="#F5F6FA"
             Shell.FlyoutBehavior="Disabled">
    <VerticalStackLayout Spacing="25" Padding="40" VerticalOptions="Center">
        <Label Text="P_335 ReadMe" FontSize="36" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#512BD4" />
        <Label Text="Bienvenue dans votre bibliothèque" FontSize="14" HorizontalOptions="Center" TextColor="#7F8C8D" Margin="0,-15,0,10" />
        
        <Frame Padding="0" CornerRadius="12" HasShadow="False" BorderColor="#DCDDE1" BackgroundColor="White">
            <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" HeightRequest="50" Margin="10,0" />
        </Frame>

        <Frame Padding="0" CornerRadius="12" HasShadow="False" BorderColor="#DCDDE1" BackgroundColor="White">
            <Entry x:Name="PasswordEntry" Placeholder="Mot de passe" IsPassword="True" HeightRequest="50" Margin="10,0" />
        </Frame>
        
        <Button Text="Se connecter" Clicked="OnLoginClicked" BackgroundColor="#512BD4" TextColor="White" CornerRadius="12" HeightRequest="50" FontAttributes="Bold" />
        <Button Text="S'inscrire" Clicked="OnRegisterClicked" BackgroundColor="Transparent" TextColor="#512BD4" />
        
        <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" HorizontalOptions="Center" Color="#512BD4" />
    </VerticalStackLayout>
</ContentPage>
